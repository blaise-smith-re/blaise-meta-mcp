# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already excluded by .gitignore.
#
# See docs/META_SETUP.md for exactly how to obtain every value below.

# --- Required: Meta credentials -------------------------------------------

# A long-lived Facebook Page Access Token (~60 days, refreshable) for the
# Page connected to Blaise's Instagram Professional account. This single
# token is used for every V1 (read-only) tool — Instagram Professional
# accounts linked via "Facebook Login for Business" are read through their
# connected Page's access token.
META_PAGE_ACCESS_TOKEN=

# The numeric Facebook Page ID this server operates on.
META_PAGE_ID=

# --- Optional: Meta credentials --------------------------------------------

# The linked Instagram Business Account ID. If left blank, the server
# resolves it automatically from META_PAGE_ID on first use.
META_IG_USER_ID=

# Only needed to run `npm run token:authorize` (the local helper that mints
# META_PAGE_ACCESS_TOKEN) and for future token-refresh tooling. Not read by
# the running server otherwise.
META_APP_ID=
META_APP_SECRET=

# Graph API version to call. Check
# https://developers.facebook.com/docs/graph-api/changelog before changing —
# do not assume the default in src/constants.ts is still current.
GRAPH_API_VERSION=v26.0

# --- Server transport --------------------------------------------------

# "stdio" for a local/desktop MCP client talking to this process directly.
# "http" for a deployed remote server Claude (claude.ai / Claude Desktop
# "Add custom connector") connects to over the network.
TRANSPORT=stdio

# Only used when TRANSPORT=http
PORT=3000
HOST=127.0.0.1

# --- Claude connector authentication (only used when TRANSPORT=http) -------
#
# IMPORTANT: this is authentication BETWEEN CLAUDE AND THIS SERVER — a
# completely separate system from the Meta credentials above. Do not confuse
# OAUTH_OWNER_PASSWORD with any Meta/Facebook password or token.
#
# Claude's own "Add custom connector" UI (claude.ai and Claude Desktop) only
# supports OAuth — it has no field to paste in a static bearer token — so
# this server implements a minimal single-user OAuth 2.1 authorization
# server (src/oauth/). See docs/SECURITY.md#claude-connector-authentication
# for the research behind this and why it can't be a simple static token.

# The externally reachable HTTPS base URL of this deployment, e.g.
# https://blaise-meta-mcp.onrender.com — required when TRANSPORT=http.
# http:// is only accepted for localhost/127.0.0.1 during local testing.
PUBLIC_URL=

# Required when TRANSPORT=http. The password Blaise enters once, in the
# browser, when Claude's connector flow redirects him here to authorize.
# Choose a long, unique passphrase — generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OAUTH_OWNER_PASSWORD=

# Optional legacy fallback, NOT usable with the claude.ai/Claude Desktop
# "Add custom connector" UI (OAuth-only). Only set this if you're wiring up
# a client that lets you set a raw Authorization header yourself — e.g.
# Claude Desktop's local JSON config file, or the MCP Inspector for testing.
# Leave blank unless you specifically need it.
MCP_SERVER_AUTH_TOKEN=

LOG_LEVEL=info

# --- Future write layer: DO NOT enable unless you mean to ------------------
#
# V1 is read-only by design. These flags exist only so a future version can
# add write actions (publishing, comment replies, message replies) behind an
# explicit opt-in. Leaving everything below unset/false keeps this server
# strictly read-only. See docs/SECURITY.md before ever setting these to true.

ENABLE_WRITE_ACTIONS=false
ALLOW_INSTAGRAM_PUBLISH=false
ALLOW_FACEBOOK_PUBLISH=false
ALLOW_COMMENT_REPLIES=false
ALLOW_MESSAGE_REPLIES=false
